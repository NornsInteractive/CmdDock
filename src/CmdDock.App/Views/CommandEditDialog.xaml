<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CmdDock_App.Views.CommandEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CmdDock.Core.Models"
    mc:Ignorable="d"
    Title="编辑快捷命令"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <Grid Width="520" MaxHeight="540">
        <!-- View 1: Main Edit Form View -->
        <ScrollViewer x:Name="EditFormScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="4">
                <TextBox x:Name="NameBox" Header="命令名称" PlaceholderText="例如: 刷新 DNS 缓存" />

                <TextBox x:Name="DescriptionBox" Header="功能描述" PlaceholderText="简述命令用途" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ShellTypeCombo" Header="执行引擎" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Name="ShellTypePwshItem" Content="PowerShell" Tag="PowerShell" IsSelected="True" />
                        <ComboBoxItem x:Name="ShellTypeCmdItem" Content="CMD (命令提示符)" Tag="Cmd" />
                        <ComboBoxItem x:Name="ShellTypeWslItem" Content="WSL (Linux Bash)" Tag="Wsl" />
                        <ComboBoxItem x:Name="ShellTypeExeItem" Content="可执行程序 (Exe)" Tag="Executable" />
                        <ComboBoxItem x:Name="ShellTypeUrlItem" Content="URL 网址协议" Tag="UrlProtocol" />
                    </ComboBox>

                    <ComboBox x:Name="ExecutionModeCombo" Header="执行模式" HorizontalAlignment="Stretch" Grid.Column="1">
                        <ComboBoxItem x:Name="ExecModeSilentItem" Content="静默后台执行 (Silent)" Tag="Silent" IsSelected="True" />
                        <ComboBoxItem x:Name="ExecModeTerminalItem" Content="弹出终端窗口 (Terminal)" Tag="Terminal" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="CategoryCombo"
                        Header="所属分类"
                        PlaceholderText="选择分类"
                        HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind DisplayIcon}" FontSize="15" Visibility="{x:Bind GlyphVisibility}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <Image Source="{x:Bind IconGlyph, Converter={StaticResource ImagePathConverter}}"
                                           Visibility="{x:Bind ImageVisibility}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Name="IconSettingsLabel" Text="图标设置" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        
                        <!-- Modern Interactive Icon Card -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon x:Name="IconFontPreview" Glyph="&#xE756;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="ImageIconPreview" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="IconSelectedNameText" Text="终端控制台 (Terminal)" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="IconSelectedCategoryText" Text="官方系统图标" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2" x:Name="OpenIconPickerBtn" Click="OpenIconPickerBtn_Click" Style="{ThemeResource AccentButtonStyle}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A9;" FontSize="13" />
                                        <TextBlock x:Name="OpenIconPickerBtnText" Text="选择图标" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3" x:Name="BrowseIconBtn" Click="BrowseIconBtn_Click" ToolTipService.ToolTip="选择本地图片文件 (.png, .jpg, .ico, .svg)" Padding="8,5">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xED43;" FontSize="13" />
                                        <TextBlock x:Name="BrowseIconBtnText" Text="图片" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="CommandTextBox" Header="执行命令 / 脚本内容" PlaceholderText="例如: ipconfig /flushdns" AcceptsReturn="True" MinHeight="70" />

                <TextBox x:Name="ArgumentsBox" Header="命令附加参数 (可选)" PlaceholderText="传递给可执行文件的参数" />

                <TextBox x:Name="WorkingDirectoryBox" Header="工作目录 (可选)" PlaceholderText="留空则默认为当前目录" />

                <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,6,0,0">
                    <CheckBox x:Name="ShowInWidgetCheck" Content="在 Win11 小组件中展示" IsChecked="True" />
                    <CheckBox x:Name="RequireConfirmCheck" Content="执行前需要二次确认" IsChecked="False" />
                </StackPanel>

                <!-- Widget Appearance Customization Section -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="WidgetAppearanceTitle" Text="小组件卡片样式自定义" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="12" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card Style Type: Only 2 options: Default Transparent and Custom Background Color -->
                            <ComboBox x:Name="WidgetStyleCombo" Header="背景模式" SelectionChanged="WidgetStyleCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="WidgetStyleTransparentItem" Content="默认透明" Tag="Transparent" IsSelected="True" />
                                <ComboBoxItem x:Name="WidgetStyleCustomItem" Content="自定义背景颜色" Tag="Custom" />
                            </ComboBox>

                            <!-- Color Palette & Custom Hex -->
                            <StackPanel Grid.Column="1" x:Name="ColorSettingPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="BgColorLabel" Text="卡片背景颜色" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="WidgetColorHexBox" PlaceholderText="例如: #2563EB" TextChanged="WidgetColorHexBox_TextChanged" />
                                    <Border Grid.Column="1" x:Name="ColorPreviewBorder" Width="32" Height="32" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="#2563EB" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Quick Swatches -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <Button Tag="#2563EB" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="科技蓝 (#2563EB)">
                                        <Border Background="#2563EB" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                    <Button Tag="#10B981" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="翠绿 (#10B981)">
                                        <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                    <Button Tag="#0D9488" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="极客青 (#0D9488)">
                                        <Border Background="#0D9488" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                    <Button Tag="#F59E0B" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="活力橙 (#F59E0B)">
                                        <Border Background="#F59E0B" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                    <Button Tag="#EF4444" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="珊瑚红 (#EF4444)">
                                        <Border Background="#EF4444" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                    <Button Tag="#8B5CF6" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="魅惑紫 (#8B5CF6)">
                                        <Border Background="#8B5CF6" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                    <Button Tag="#1F2937" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="暗夜黑 (#1F2937)">
                                        <Border Background="#1F2937" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                    <Button Tag="#E5E7EB" Click="ColorSwatch_Click" Padding="0" Width="22" Height="22" CornerRadius="11" ToolTipService.ToolTip="浅灰白 (#E5E7EB)">
                                        <Border Background="#E5E7EB" Width="20" Height="20" CornerRadius="10" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- View 2: Dedicated Icon Picker Modal View with Real-Time Fuzzy Search -->
        <Grid x:Name="IconPickerPanel" Visibility="Collapsed" MinHeight="480" MaxHeight="520" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Back Button & Title -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackFromPickerBtn" Click="BackFromPickerBtn_Click" VerticalAlignment="Center" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock x:Name="BackFromPickerBtnText" Text="返回表单" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" x:Name="IconPickerTitleText" Text="选择系统图标" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="IconCountBadge" Text="共 88 款" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <!-- Row 1: Search Box -->
            <TextBox Grid.Row="1" x:Name="IconSearchBox" PlaceholderText="输入关键词模糊搜索 (如: 终端, cmd, 网络, wifi, 设置, git, 锁屏...)" TextChanged="IconSearchBox_TextChanged" HorizontalAlignment="Stretch" />

            <!-- Row 2: Category Filter Buttons -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                    <Button x:Name="CatAllBtn" Content="全部" Tag="全部" Click="CategoryBtn_Click" Style="{ThemeResource AccentButtonStyle}" Padding="12,4" FontSize="12" />
                    <Button x:Name="CatOpsBtn" Content="常用与操作" Tag="常用与操作" Click="CategoryBtn_Click" Padding="12,4" FontSize="12" />
                    <Button x:Name="CatHwBtn" Content="系统与硬件" Tag="系统与硬件" Click="CategoryBtn_Click" Padding="12,4" FontSize="12" />
                    <Button x:Name="CatNetBtn" Content="网络通信" Tag="网络通信" Click="CategoryBtn_Click" Padding="12,4" FontSize="12" />
                    <Button x:Name="CatDevBtn" Content="开发与运维" Tag="开发与运维" Click="CategoryBtn_Click" Padding="12,4" FontSize="12" />
                </StackPanel>
            </ScrollViewer>

            <!-- Row 3: GridView of Icons with ScrollViewer -->
            <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                <GridView x:Name="IconsGridView"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="IconsGridView_ItemClick"
                          HorizontalAlignment="Stretch">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:IconItem">
                            <Border Width="92" Height="78"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    ToolTipService.ToolTip="{x:Bind DisplayTitle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind LocalizedName, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="84" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Border>

            <!-- Row 4: Empty search state & bottom hint -->
            <Grid Grid.Row="4" Margin="0,2,0,0">
                <TextBlock x:Name="IconSearchHint" Text="💡 点击任意图标卡片即可直接应用并返回" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Button x:Name="IconPickerBottomBackBtn" Content="返回" HorizontalAlignment="Right" Click="BackFromPickerBtn_Click" Padding="16,4" FontSize="12" />
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
