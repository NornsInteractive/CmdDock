<ContentDialog
    x:Class="CmdDock_App.Views.CategoryManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CmdDock.Core.Models"
    xmlns:converters="using:CmdDock_App.Converters"
    mc:Ignorable="d"
    Title="分类管理"
    PrimaryButtonText="完成"
    DefaultButton="Primary"
    Width="520">

    <Grid>
        <!-- 1. Main Categories Panel -->
        <Grid x:Name="MainCategoriesPanel" RowSpacing="14" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Description -->
            <TextBlock
                x:Name="DialogDescText"
                Text="管理命令分类与图标。修改或删除分类时，将自动同步更新关联的快捷命令和小组件。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                FontSize="13" />

            <!-- Add Category Section -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon button for new category -->
                <Button
                    x:Name="NewCategoryIconBtn"
                    Click="NewCategoryIconBtn_Click"
                    Padding="6"
                    ToolTipService.ToolTip="为新分类选择图标">
                    <Grid Width="22" Height="22">
                        <FontIcon x:Name="NewCategoryFontIcon" Glyph="&#xE8EC;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="NewCategoryImgIcon" Visibility="Collapsed" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <TextBox
                    Grid.Column="1"
                    x:Name="NewCategoryBox"
                    PlaceholderText="输入新分类名称..."
                    KeyDown="NewCategoryBox_KeyDown" />

                <Button
                    Grid.Column="2"
                    x:Name="AddCategoryBtn"
                    Click="AddCategoryBtn_Click"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock x:Name="AddCategoryBtnText" Text="添加分类" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Categories List -->
            <Border
                Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="200"
                MaxHeight="320">
                <ListView
                    x:Name="CategoriesListView"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="44" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Direct Icon Switcher Button -->
                                <Button
                                    Tag="{Binding}"
                                    Click="ChangeCategoryIconBtn_Click"
                                    Padding="5"
                                    ToolTipService.ToolTip="{Binding ChangeIconToolTip}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                    <Grid Width="24" Height="24">
                                        <FontIcon Glyph="{Binding DisplayIcon}" FontSize="16" Visibility="{Binding GlyphVisibility}"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding IconGlyph, Converter={StaticResource ImagePathConverter}}"
                                               Visibility="{Binding ImageVisibility}" Width="20" Height="20" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding DisplayName}"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- Command Count Badge -->
                                <Border
                                    Grid.Column="2"
                                    Background="{ThemeResource SystemAccentColorLight3}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding CountText}"
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button
                                        Tag="{Binding}"
                                        Click="MoveUpBtn_Click"
                                        Padding="5,4"
                                        ToolTipService.ToolTip="{Binding MoveUpToolTip}">
                                        <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                    </Button>
                                    <Button
                                        Tag="{Binding}"
                                        Click="MoveDownBtn_Click"
                                        Padding="5,4"
                                        ToolTipService.ToolTip="{Binding MoveDownToolTip}">
                                        <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                    </Button>
                                    <Button
                                        Tag="{Binding}"
                                        Click="EditCategoryBtn_Click"
                                        Padding="5,4"
                                        ToolTipService.ToolTip="{Binding EditToolTip}">
                                        <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                    </Button>
                                    <Button
                                        Tag="{Binding}"
                                        Click="DeleteBtn_Click"
                                        Padding="5,4"
                                        ToolTipService.ToolTip="{Binding DeleteToolTip}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Inline Status Hint -->
            <TextBlock
                Grid.Row="3"
                x:Name="StatusHintText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Left" />
        </Grid>

        <!-- 2. Edit Category Panel -->
        <Grid x:Name="EditCategoryPanel" Visibility="Collapsed" RowSpacing="14" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackFromEditBtn" Click="BackFromEditBtn_Click" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock x:Name="BackFromEditBtnText" Text="返回列表" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" x:Name="EditPanelTitleText" Text="编辑分类" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>

            <!-- Edit Form -->
            <StackPanel Grid.Row="1" Spacing="16" Margin="0,8,0,0">
                <TextBox x:Name="EditCategoryNameBox" Header="分类名称" PlaceholderText="输入分类名称..." />

                <StackPanel Spacing="6">
                    <TextBlock x:Name="EditCategoryIconLabel" Text="分类图标" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon x:Name="EditCategoryFontIcon" Glyph="&#xE8EC;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <Image x:Name="EditCategoryImgIcon" Visibility="Collapsed" Width="30" Height="30" Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="EditCategoryIconNameText" Text="当前图标" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="EditCategoryIconDesc" Text="点击右侧按钮更换系统官方图标或本地图片" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="ChangeEditIconBtn" Click="ChangeEditIconBtn_Click" Content="选择图标" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Footer Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="CancelEditCategoryBtn" Content="取消" Click="BackFromEditBtn_Click" Padding="16,6" />
                <Button x:Name="SaveEditCategoryBtn" Click="SaveEditCategoryBtn_Click" Content="保存修改" Style="{ThemeResource AccentButtonStyle}" Padding="16,6" />
            </StackPanel>
        </Grid>

        <!-- 3. Icon Picker Panel -->
        <Grid x:Name="IconPickerPanel" Visibility="Collapsed" RowSpacing="10" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackFromPickerBtn" Click="BackFromPickerBtn_Click" VerticalAlignment="Center" Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock x:Name="BackFromPickerBtnText" Text="返回" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" x:Name="IconPickerTitleText" Text="选择分类图标" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="IconCountBadge" Text="共 88 款" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <!-- Row 1: Search & Local Picture Pick -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IconSearchBox" PlaceholderText="输入关键词模糊搜索 (如: 星, 网络, 系统, 代码, 文件夹...)" TextChanged="IconSearchBox_TextChanged" />
                <Button Grid.Column="1" x:Name="BrowseLocalIconBtn" Click="BrowseLocalIconBtn_Click" ToolTipService.ToolTip="从本地文件选择 PNG/JPG/ICO 图片">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB9F;" FontSize="13" />
                        <TextBlock x:Name="BrowseLocalIconBtnText" Text="本地图片" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 2: Category Filter Buttons -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                    <Button x:Name="CatAllBtn" Content="全部" Tag="全部" Click="CategoryBtn_Click" Style="{ThemeResource AccentButtonStyle}" Padding="10,4" FontSize="12" />
                    <Button x:Name="CatOpsBtn" Content="常用与操作" Tag="常用与操作" Click="CategoryBtn_Click" Padding="10,4" FontSize="12" />
                    <Button x:Name="CatHwBtn" Content="系统与硬件" Tag="系统与硬件" Click="CategoryBtn_Click" Padding="10,4" FontSize="12" />
                    <Button x:Name="CatNetBtn" Content="网络通信" Tag="网络通信" Click="CategoryBtn_Click" Padding="10,4" FontSize="12" />
                    <Button x:Name="CatDevBtn" Content="开发与运维" Tag="开发与运维" Click="CategoryBtn_Click" Padding="10,4" FontSize="12" />
                </StackPanel>
            </ScrollViewer>

            <!-- Row 3: GridView -->
            <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Height="220">
                <GridView x:Name="IconsGridView"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="IconsGridView_ItemClick"
                          HorizontalAlignment="Stretch">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:IconItem">
                            <Border Width="84" Height="70"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    ToolTipService.ToolTip="{x:Bind DisplayTitle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind LocalizedName, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="76" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Border>

            <!-- Row 4: Hint -->
            <TextBlock Grid.Row="4" x:Name="IconSearchHint" Text="💡 点击任意图标卡片即可直接应用并返回" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</ContentDialog>
